    <string name="workspace_spec_title">Template authoring spec v1</string>
    <string name="workspace_spec_intro">Zip the complete template directory. The ZIP root may contain template.json directly, or a single template folder.</string>
    <string name="workspace_spec_min_structure">Minimal structure</string>
    <string name="workspace_spec_min_structure_body">template.json\npreview.png (optional, 270×270)\nproject files or *.template\ntemplate-hooks/ (optional)</string>
    <string name="workspace_spec_manifest">Manifest rules</string>
    <string name="workspace_spec_manifest_body">id accepts lowercase letters, digits, dots, underscores and dashes; builtin. is a reserved prefix. projectType supports ANDROID, FLUTTER, GENERAL. category groups templates.</string>
    <string name="workspace_spec_variables">Variables and files</string>
    <string name="workspace_spec_variables_body">Project name and location are filled in by the workshop. Templates declare dynamic fields via variables, supporting TEXT, MULTILINE, NUMBER, BOOLEAN, SELECT, SECRET. File contents and paths can use {{variableName}}; any text file may carry a .template suffix that is removed on generation. Package folders use WANXIANG_PACKAGE_PATH. Hidden required variables must have defaults, except system-derived ones.</string>
    <string name="workspace_spec_preview">Preview image</string>
    <string name="workspace_spec_preview_body">PNG, JPEG, WebP and GIF are supported, up to 4 MiB each. Previews are 1:1 and must be exactly 270×270 px.</string>
    <string name="workspace_spec_hooks">Hook scripts</string>
    <string name="workspace_spec_hooks_body">beforeCreate and afterCreate must point to scripts under template-hooks/. They run only with explicit user consent when creating a project, inside the sandbox project directory, for up to 60 seconds. Variables arrive via WANXIANG_VAR_&lt;UPPERCASE_NAME&gt; environment variables; the project path is WANXIANG_PROJECT_DIR.</string>
    <string name="workspace_spec_validation">Result validation</string>
    <string name="workspace_spec_validation_body">validation can declare requiredFiles, forbiddenFiles and contentRules; paths and contents support template variables. Validation runs after afterCreate completes.</string>
    <string name="workspace_spec_footer">Export any bundled template as a full sample; change the id and remove the reserved builtin. prefix before importing.</string>
    <string name="workspace_spec_got_it">Got it</string>

