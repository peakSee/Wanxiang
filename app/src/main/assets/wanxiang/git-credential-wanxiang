#!/bin/sh
# 万象 自定义 git credential helper：三端（UI 按钮 / AI Bash / 交互终端手敲）git 缺凭据时的统一兜底入口。
#
# 配置在容器 /root/.gitconfig 的 credential.helper，排在 `store` 之后（双保险）：
#   git config --global credential.helper 'store --file=/wanxiang-ipc/git-credentials'
#   git config --global credential.helper '/wanxiang-ipc/git-credential-wanxiang'
# git 的多 helper 是顺序串行、凭据累加——本 helper 总会被调，故被调用 ≠ 未登录。
# 必须自查 /wanxiang-ipc/git-credentials 是否已有该 host 条目：
#   命中 → 空退出，让链上 store 已返回的凭据生效。
#   未命中 → 经文件 IPC 通知 app 弹窗（写 cred-req-<id>）→ 阻塞轮询 cred-resp-<id> →
#            取回明文 KV 喂给 git（git 自己处理），随后清理临时文件。
#
# 经 PRoot -b 绑定：容器内 /wanxiang-ipc ⇔ 宿主 filesDir/linux-runtime/git-ipc 同一 inode，
# 故 app 侧 FileObserver 监听宿主目录的 cred-req-* 创建事件即可触发全局弹窗。
# 仅 HTTPS 生效：git 只对 http/https remote 调 credential helper 的 get，SSH 走 ssh-agent 不触发。

op="$1"
# 只处理 get；store/erase 空退出（凭据落盘由 app 侧 GitCredentialsFileSync 负责）。
[ "$op" = "get" ] || exit 0

# 读 stdin 全部 KV，拿 host（git credential 协议字段已小写归一）。
host=""
while IFS= read -r line; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done
[ -n "$host" ] || exit 0

# 自查 store 文件：每行形如 https://user:token@host，host 在 @ 后、行尾。
CREDS=/wanxiang-ipc/git-credentials
if [ -f "$CREDS" ]; then
  # @host 行尾精确匹配，避免 gist.github.com 误命中 github.com。
  if grep -q "@${host}\$" "$CREDS" 2>/dev/null; then
    exit 0
  fi
fi

# 未命中 → 写请求文件（原子写：先 .tmp 再 mv，触发 inotify 且避免 app 读半截），阻塞轮询响应。
IPC=/wanxiang-ipc
RID="$(date +%s)-$$"
REQ="$IPC/cred-req-$RID"
RESP="$IPC/cred-resp-$RID"
printf 'host=%s\n' "$host" > "$REQ.tmp"
mv "$REQ.tmp" "$REQ"

# 轮询响应（200ms 一次），绝对上限 ~25 分钟（配合 watchdog 30 分钟兜底），超时放弃，删请求退出非零。
i=0
while [ ! -f "$RESP" ]; do
  sleep 0.2
  i=$((i + 1))
  [ "$i" -gt 7500 ] && { rm -f "$REQ"; exit 1; }
done

# 响应文件内容：明文 KV username=...\npassword=... 或 cancel=1。
if grep -q '^cancel=1' "$RESP" 2>/dev/null; then
  rm -f "$REQ" "$RESP"
  exit 1
fi

cat "$RESP"
rm -f "$REQ" "$RESP"
